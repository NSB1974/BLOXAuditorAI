# BLOXAuditorAI environment variables
# Copy this file to ".env" and fill in real values.
# NEVER commit your real .env file.

# -----------------------------------------------------------------------------
# Block explorer API keys (used to fetch verified Solidity source)
# -----------------------------------------------------------------------------

# Required for Ethereum mainnet / Sepolia audits (Etherscan)
# Obtain a free key at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=""

# Required only when auditing Base contracts (BaseScan)
# Obtain a key at https://basescan.org/myapikey
BASESCAN_API_KEY=""

# Required only when auditing Polygon contracts (PolygonScan)
# Obtain a key at https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=""

# Required only when auditing Kava contracts (KavaScan)
# Obtain a key at https://kavascan.com/myapikey
KAVASCAN_API_KEY=""
