# BLOXAuditorAI environment variables
# Copy this file to ".env" and fill in real values.
# NEVER commit your real .env file.

# -----------------------------------------------------------------------------
# Block explorer API keys (used to fetch verified Solidity source)
# -----------------------------------------------------------------------------

# Used for Ethereum mainnet / Sepolia audits (Etherscan), and can also be used
# for Base and Polygon via the Etherscan v2 API (`chainid`-based endpoint).
# Obtain a free key at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=""

# Optional alternative for Base audits (BaseScan) if not using ETHERSCAN_API_KEY
# via the Etherscan v2 API.
# Obtain a key at https://basescan.org/myapikey
BASESCAN_API_KEY=""

# Optional alternative for Polygon audits (PolygonScan) if not using
# ETHERSCAN_API_KEY via the Etherscan v2 API.
# Obtain a key at https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=""

# Required only when auditing Kava contracts (KavaScan)
# Obtain a key at https://kavascan.com/myapikey
KAVASCAN_API_KEY=""
