# xAI (Grok) API key — used to generate the smart contract audit report.
# Obtain a key at https://console.x.ai/
CONSOLEXAI_API_KEY=your_xai_api_key_here

# Etherscan API key — used to fetch verified Solidity source code for a given contract address.
# Obtain a free key at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Basescan API key — required when auditing Base contracts.
# Obtain a key at https://basescan.org/myapikey
BASESCAN_API_KEY=your_basescan_api_key_here

# Polygonscan API key — required when auditing Polygon contracts.
# Obtain a key at https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# Kavascan API key — required when auditing Kava contracts.
# Obtain a key at https://kavascan.com/myapikey
KAVASCAN_API_KEY=your_kavascan_api_key_here

# ERC-20 token used to pay for Base audits.
BLOXOLOGY_TOKEN_ADDRESS=0xYourTokenAddressOnBase

# Treasury wallet that receives payment transfers for Base audits.
AUDIT_TREASURY_ADDRESS=0xYourTreasuryAddressOnBase

# Base mainnet RPC URL used server-side to verify payment transactions.
BASE_RPC_URL=https://mainnet.base.org

# Required token amount in smallest units (wei-like integer, no decimals).
AUDIT_REQUIRED_TOKEN_AMOUNT=1000000000000000000

# Public client-side equivalents used by the UI payment flow.
NEXT_PUBLIC_BLOXOLOGY_TOKEN_ADDRESS=0xYourTokenAddressOnBase
NEXT_PUBLIC_AUDIT_TREASURY_ADDRESS=0xYourTreasuryAddressOnBase
NEXT_PUBLIC_AUDIT_REQUIRED_TOKEN_AMOUNT=1000000000000000000
